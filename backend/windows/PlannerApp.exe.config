<?xml version="1.0" encoding="utf-8"?>
<!--
  Configurazione di .NET Framework per PlannerApp.exe, copiata accanto all'eseguibile
  dalla build Windows. pywebview carica con pythonnet le DLL .NET in _internal\:
  se lo ZIP e stato scaricato da Internet, Windows le segna come remote e .NET
  rifiuta di caricarle ("Failed to resolve Python.Runtime.Loader.Initialize").
  loadFromRemoteSources le tratta come locali, solo per questo processo.
-->
<configuration>
  <runtime>
    <loadFromRemoteSources enabled="true" />
  </runtime>
</configuration>
